{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eyezen",
  "version": "0.1.0",
  "identifier": "com.eyezen.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main-window",
        "title": "Eyezen",
        "url": "/index.html",
        "width": 520,
        "height": 640,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "tray-panel",
        "title": "",
        "url": "/tray.html",
        "width": 320,
        "height": 196,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2026 Maple",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Maple",
    "shortDescription": "Cross-platform desktop eye care app based on the 20-20-20 rule",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
