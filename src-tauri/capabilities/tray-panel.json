{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-panel",
  "description": "Tray panel capabilities",
  "windows": ["tray-panel"],
  "permissions": [
    "core:event:allow-unlisten",
    {
      "identifier": "core:event:allow-listen",
      "allow": [{ "event": "config_changed" }, { "event": "state_changed" }]
    },
    "allow-get-config",
    "allow-get-state-snapshot",
    "allow-start-rest",
    "allow-skip-rest",
    "allow-pause-timer",
    "allow-resume-timer"
  ]
}
