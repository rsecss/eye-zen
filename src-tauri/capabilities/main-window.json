{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window capabilities",
  "windows": ["main-window"],
  "permissions": [
    "shell:allow-open",
    "core:event:allow-unlisten",
    {
      "identifier": "core:event:allow-listen",
      "allow": [{ "event": "config_changed" }, { "event": "state_changed" }]
    },
    "allow-get-state-snapshot",
    "allow-pause-timer",
    "allow-resume-timer",
    "allow-get-config",
    "allow-update-timer-config",
    "allow-update-behavior-config",
    "allow-update-display-config"
  ]
}
