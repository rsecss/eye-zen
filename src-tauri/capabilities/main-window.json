{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window capabilities",
  "windows": ["main-window"],
  "permissions": [
    "shell:default",
    "core:event:allow-unlisten",
    {
      "identifier": "core:event:allow-listen",
      "allow": [
        { "event": "config_changed" },
        { "event": "state_changed" },
        { "event": "navigate_tab" },
        { "event": "hotkey_status_changed" }
      ]
    },
    "allow-get-state-snapshot",
    "allow-pause-timer",
    "allow-resume-timer",
    "allow-get-config",
    "allow-get-hotkey-status",
    "allow-get-statistics-trends",
    "allow-get-detector-capabilities",
    "allow-update-timer-config",
    "allow-update-behavior-config",
    "allow-update-display-config",
    "allow-update-schedule-config",
    "allow-update-hotkeys-config",
    "allow-update-pomodoro-config",
    "core:window:allow-set-theme",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
