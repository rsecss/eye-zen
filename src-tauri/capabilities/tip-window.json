{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tip-window",
  "description": "Tip window capabilities",
  "windows": ["tip-window-*", "tip-window-minimal-*", "tip-window-fallback"],
  "permissions": [
    "core:event:allow-unlisten",
    {
      "identifier": "core:event:allow-listen",
      "allow": [{ "event": "state_changed" }, { "event": "config_changed" }]
    },
    "allow-get-config",
    "allow-get-state-snapshot",
    "allow-start-rest",
    "allow-skip-rest"
  ]
}
